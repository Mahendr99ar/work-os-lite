# Copy this file to .env and fill in your own values. Never commit .env.

# Docker Compose sets DATABASE_URL for you. On Render, paste your Neon connection string here.
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Which AI to use: groq (free), gemini (free), openai or anthropic.
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional. Each provider has a default model; set this only to change it.
# LLM_MODEL=llama-3.3-70b-versatile
# Optional. Only for another OpenAI-compatible host.
# LLM_BASE_URL=

# hash = free and offline. openai = better matches, needs OPENAI_API_KEY.
# Changing this after uploading documents means uploading them again (vector size changes).
EMBEDDING_PROVIDER=hash
# OPENAI_API_KEY=

# Questions whose best match scores below this are refused without calling the AI.
MIN_SIMILARITY=0.15

# true lets visitors open a private sandbox workspace from the login page.
DEMO_MODE=true

# Frontend URLs allowed to call the API, comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173
# Optional regex for Vercel preview URLs, e.g. https://work-os-lite-.*\.vercel\.app
# CORS_ORIGIN_REGEX=
